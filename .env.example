# ── Dominio base — nunca hardcodear URLs, todo se arma a partir de esto ──
# En desarrollo local:
BASE_DOMAIN=localhost:3000
BASE_PROTOCOL=http
# En producción sería algo como:
# BASE_DOMAIN=tuapp.com
# BASE_PROTOCOL=https

# ── Base de datos ──
DATABASE_URL=postgres://pettapp:pettapp_dev@localhost:5432/pettapp_dev

# ── Redis (cola de jobs) ──
REDIS_URL=redis://localhost:6379

# ── Better Auth ──
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Better Auth arma su propia base URL leyendo BASE_DOMAIN/BASE_PROTOCOL (ver src/lib/env.ts),
# no hace falta duplicarla acá.

# ── Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (para enviar el magic link) ──
# Cualquier proveedor transaccional sirve (Resend, Postmark, SES...).
EMAIL_FROM="La app de tu mascota <hola@tuapp.com>"
RESEND_API_KEY=

# ── Storage ──
# "local" para desarrollo (guarda archivos en disco, sin depender de credenciales reales)
# "r2" para Cloudflare R2
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./.storage

# Solo necesarios cuando STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pettapp-media
