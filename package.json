{
  "name": "pettapp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "drizzle-orm": "^0.36.0"
  },
  "overrides": {
    "drizzle-orm": "$drizzle-orm"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:worker": "npm run dev --workspace=apps/media-worker",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "test:pure": "node apps/web/src/lib/host.test.mjs && node apps/web/src/lib/qr.test.mjs"
  }
}